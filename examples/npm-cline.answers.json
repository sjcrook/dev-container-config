{
    "schemaVersion": 2,
    "name": "ClineDevContainer",
    "remoteUser": "vscode",
    "dockerfileBuild": {
        "toolchains": {
            "node": {
                "version": "22"
            }
        }
    },
    "mounts": [
        {
            "source": "command-exceptions",
            "target": "/workspace/command-exceptions",
            "readonly": true
        },
        {
            "source": "external",
            "target": "/workspace/external",
            "readonly": true
        },
        {
            "source": ".git/modules",
            "target": "/workspace/.git/modules",
            "readonly": true
        },
        {
            "source": ".devcontainer",
            "target": "/workspace/.devcontainer",
            "readonly": true
        },
        {
            "source": ".cline/hooks",
            "target": "/workspace/.cline/hooks",
            "readonly": true
        },
        {
            "source": ".clinerules/hooks",
            "target": "/workspace/.clinerules/hooks",
            "readonly": true
        },
        {
            "source": ".github/hooks",
            "target": "/workspace/.github/hooks",
            "readonly": true
        },
        {
            "source": ".cline/skills",
            "target": "/workspace/.cline/skills",
            "readonly": true
        },
        {
            "source": ".github/agents",
            "target": "/workspace/.github/agents",
            "readonly": true
        },
        {
            "source": ".github/prompts",
            "target": "/workspace/.github/prompts",
            "readonly": true
        },
        {
            "source": "AGENTS.md",
            "target": "/workspace/AGENTS.md",
            "readonly": true
        },
        {
            "source": "../../laravel_dac_formatter",
            "target": "/workspace/data/laravel_dac_formatter",
            "readonly": true
        },
        {
            "source": "../../laravel_ipty",
            "target": "/workspace/data/laravel_ipty",
            "readonly": true
        }
    ],
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
    },
    "postCreateCommand": "npm install --global --prefix $HOME/.local cline",
    "customizations": {
        "vscode": {
            "extensions": [
                "saoudrizwan.claude-dev"
            ]
        }
    }
}