{
  "schemaVersion": 2,
  "name": "AppDevContainer",
  "remoteUser": "vscode",
  "dockerfileBuild": {
    "toolchains": {
      "node": { "version": "22" },
      "java": { "version": "17" },
      "pnpm": { "npmrcPath": "./example.npmrc" }
    }
  },
  "mounts": [
    { "source": "data", "target": "/workspace/data", "readonly": true }
  ],
  "blockedRegistryHostsFile": "examples/blockedRegistryHosts.txt",
  "extraHosts": {
    "test.ipresenttoyou.com": "host-gateway"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspace/node_modules/.bin"
  },
  "javaProjectSourcePaths": ["external/ml-genai-demo-v2/src"],
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "angular.ng-template", "esbenp.prettier-vscode", "saoudrizwan.claude-dev"]
    }
  }
}
